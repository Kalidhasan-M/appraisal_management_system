# Copy to secrets.yaml and fill in values. Do NOT commit secrets.yaml.
# kubectl create secret generic ams-secrets --from-literal=APP_KEY=base64:xxx --from-literal=DB_USERNAME=ams --from-literal=DB_PASSWORD=secret
apiVersion: v1
kind: Secret
metadata:
  name: ams-secrets
type: Opaque
stringData:
  APP_KEY: "base64:YOUR_APP_KEY_HERE"
  DB_USERNAME: "ams"
  DB_PASSWORD: "secret"
